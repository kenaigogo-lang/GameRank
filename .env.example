# ── 前端（會打包進網頁，這些是 Firebase 的公開設定，不是秘密）──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── 伺服器端（只給 api/ 的 Vercel 函式用，不會出現在網頁裡）──
# 不要加 VITE_ 前綴，否則有被打包進前端的風險。
# 舊的 VITE_ 名稱目前仍相容，但建議改成下面的名稱。
FIREBASE_PROJECT_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_CX=
GEMINI_API_KEY=
# 選填，預設 gemini-2.5-flash
GEMINI_MODEL=
